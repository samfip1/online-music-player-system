PORT=4000
# Must match where the client runs. Use 127.0.0.1, not localhost (Spotify rejects localhost).
CLIENT_URL=http://127.0.0.1:5173

# Matches docker-compose.yml (port 5433 so it does not clash with other local Postgres)
DATABASE_URL=postgresql://sonicvote:sonicvote@127.0.0.1:5433/sonicvote

# Generate each with: openssl rand -hex 32
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# From https://developer.spotify.com/dashboard (your app → Settings)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/api/auth/spotify/callback

# Optional, phase 9 (Razorpay test mode keys: Dashboard → Account & Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
# Optional: the Pro Host plan (Pro + host insights). Leave empty to offer only Pro.
RAZORPAY_HOST_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Optional, admin dashboard: your Spotify user id (Spotify app → Profile → ⋯ → Share → Copy link; the id is after /user/).
# Comma-separated for several admins.
ADMIN_SPOTIFY_IDS=
